<Window x:Class="DwgTimedEncryptor.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ecrypt4Dwg - DWG 定时加密工具" Icon="Assets/ecrypt4Dwg.ico" Height="540" Width="820" MinHeight="540" MinWidth="820"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="18" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <GroupBox Header="设置定时加密任务" Padding="12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="12" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="12" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="目标文件：" />
        <TextBox x:Name="TargetPathTextBox" Grid.Row="0" Grid.Column="1" Margin="8,0" />
        <Button Grid.Row="0" Grid.Column="2" Padding="14,4" Click="ChooseFile_Click" Content="选择文件" />

        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="锁定时间：" />
        <TextBox x:Name="DueAtTextBox" Grid.Row="2" Grid.Column="1" Margin="8,0" />
        <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Text="YYYY-MM-DD HH:MM:SS" />

        <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
          <Button Padding="18,6" Click="CreateTask_Click" Content="一键设置定时加密" />
          <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#666"
                     Text="到期后生成 .locked 文件并删除原明文文件。" />
        </StackPanel>
      </Grid>
    </GroupBox>

    <GroupBox Grid.Row="2" Header="当前任务" Padding="8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
          <Button Padding="14,4" Click="Refresh_Click" Content="刷新" />
          <Button Padding="14,4" Margin="8,0,0,0" Click="CheckNow_Click" Content="立即执行检查" />
          <Button Padding="14,4" Margin="8,0,0,0" Click="CancelTask_Click" Content="取消选中任务" />
          <Button Padding="14,4" Margin="8,0,0,0" Click="Unlock_Click" Content="使用私钥解锁" />
        </StackPanel>
        <DataGrid x:Name="TasksGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  CanUserAddRows="False" HeadersVisibility="Column">
          <DataGrid.Columns>
            <DataGridTextColumn Header="文件" Binding="{Binding TargetPath}" Width="*" />
            <DataGridTextColumn Header="锁定时间" Binding="{Binding DueAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="180" />
            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </GroupBox>

    <TextBlock x:Name="StatusTextBlock" Grid.Row="3" Margin="0,12,0,0" Foreground="#555" TextWrapping="Wrap" />
  </Grid>
</Window>
